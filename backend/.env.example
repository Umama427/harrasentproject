# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
NODE_ENV=development

# Local MongoDB (same server where your university_harassment_db already lives)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=university_harassment_db

# Long random string (at least 32 chars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Flutter web origin allowed by CORS (Flutter picks a random port; use "*" only in development)
CORS_ORIGIN=*

# Email (OTP). Leave SMTP_HOST empty in development: OTP is printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="University Complaint System <no-reply@example.edu>"

# Evidence storage (private folder, never served publicly)
UPLOAD_DIR=./private_uploads
MAX_UPLOAD_MB=10
